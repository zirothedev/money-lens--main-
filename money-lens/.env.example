DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave blank for SQLite; e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=
# Statement upload settings
STATEMENT_MAX_UPLOAD_MB=10
STATEMENT_EXPIRY_MINUTES=60
# Private storage location (must NOT be under MEDIA/static)
PRIVATE_UPLOAD_ROOT=
# Display-only: currency symbol used when a statement doesn't state its currency (e.g. NGN). Blank = no symbol.
REPORT_FALLBACK_CURRENCY=
